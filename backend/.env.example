DJANGO_SECRET_KEY=replace-with-a-secure-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Production PostgreSQL connection URL
DATABASE_URL=

PAYMENT_GATEWAY=paystack
PAYMENT_GATEWAY_SECRET_KEY=replace-with-paystack-secret-key
PAYMENT_GATEWAY_PUBLIC_KEY=replace-with-paystack-public-key
PAYMENT_CALLBACK_URL=http://localhost:5173/app/subscription

# Trusted frontend origins for API access
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Production HTTPS security settings
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_SSL_HEADER=False
THROTTLE_RATE_SUBSCRIPTION_PAYMENT_INITIALIZE=10/min
THROTTLE_RATE_SUBSCRIPTION_PAYMENT_VERIFY=30/min
THROTTLE_RATE_PAYSTACK_WEBHOOK=300/min

# StockFlow live provider activation
# Generate a Fernet key for production, for example:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STOCKFLOW_INTEGRATION_DATA_KEY=

# QuickBooks Online OAuth application
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox

# Xero OAuth application
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Shopify public/standalone app OAuth application
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_API_VERSION=2026-07
